{
  "compilerOptions": {
    "target": "ES2022",            
    "module": "nodenext",   
    "moduleResolution": "nodenext",  
    "declaration": true,       
    "rootDir": "src",          
    "outDir": "dist",             
    "strict": true,              
    "esModuleInterop": true,        
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
  },
  "include": ["src"]
}